# ── Pinterest API ─────────────────────────────────────────────────────────────
# Create your app at https://developers.pinterest.com/apps/
PINTEREST_APP_ID=your_pinterest_app_id_here
PINTEREST_APP_SECRET=your_pinterest_app_secret_here

# Access token — set manually OR obtained via the /pinterest/connect OAuth flow
PINTEREST_ACCESS_TOKEN=your_pinterest_access_token_here

# The ID of the Pinterest board to post pins to
# Find it from the Setup page after connecting your account
PINTEREST_BOARD_ID=your_board_id_here

# OAuth redirect URI — must match what you set in your Pinterest app settings
# Example: https://your-domain.com/pinterest/callback
PINTEREST_REDIRECT_URI=http://localhost:8080/pinterest/callback

# ── Affiliate & Branding ──────────────────────────────────────────────────────
# Your Benable affiliate storefront URL (this is what all pins link to)
BENABLE_URL=https://benable.com/auragirlcreations

# Your brand name shown as a signature at the bottom of every pin image
BRAND_NAME=Aura Girl Essentials

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Google Cloud project ID with Vertex AI / Imagen enabled
# Enable at: https://console.cloud.google.com/vertex-ai
GOOGLE_PROJECT_ID=your-google-project-id
GOOGLE_LOCATION=us-central1

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Password to access the dashboard
DASHBOARD_PASSWORD=your-secure-dashboard-password

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, recommended for single-instance deployment)
DATABASE_URL=sqlite:///pins.db

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# Set to "1" to enable Flask debug mode (development only!)
# FLASK_DEBUG=0
